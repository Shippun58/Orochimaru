<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sourceCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:focusable="true"
    android:nextFocusRight="@+id/dragHandle">

    <LinearLayout
        android:id="@+id/dragHandle"
        android:layout_width="36dp"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="-10dp"
        android:layout_marginEnd="3dp"
        android:orientation="vertical"
        android:gravity="center"
        android:focusable="true"
        android:nextFocusRight="@+id/updateTextView"
        android:nextFocusLeft="@id/sourceCardView">

        <ImageView
            android:id="@+id/dragUpArrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_round_drag_handle_24"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/dragDownArrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_round_drag_handle_24"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <ImageView
        android:id="@+id/sourceIconImageView"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="9dp"
        android:importantForAccessibility="no"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sourceNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semi_bold"
            android:textSize="15sp"
            tools:text="HiAnime" />

        <TextView
            android:id="@+id/sourceMetaTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semi_bold"
            android:textSize="10sp"
            tools:ignore="SmallSp"
            tools:text="v1.0.8 • anime • en" />
    </LinearLayout>

    <TextView
        android:id="@+id/updateTextView"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="6dp"
        android:layout_weight="0"
        android:background="@drawable/bg_lens_pill"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:nextFocusLeft="@id/dragHandle"
        android:nextFocusRight="@+id/overflowImageView"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="Update"
        android:textColor="?attr/colorOnSurface"
        android:textSize="11sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/overflowImageView"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="4dp"
        android:layout_weight="0"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="More options"
        android:focusable="true"
        android:nextFocusLeft="@id/updateTextView"
        android:nextFocusRight="@id/sourceCardView"
        android:padding="4dp"
        app:srcCompat="@drawable/ic_round_dots_vertical_24"
        app:tint="?attr/colorOnBackground" />
</LinearLayout>
