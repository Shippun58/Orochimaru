<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tmdbExploreContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include layout="@layout/layout_trending" />

    <HorizontalScrollView
        android:id="@+id/tmdbExploreTypeScroll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="0dp"
        android:clipToPadding="false"
        android:focusable="true"
        android:nextFocusUp="@+id/trendingViewPager"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:scrollbarSize="0dp">

        <LinearLayout
            android:id="@+id/tmdbExploreTypeCont"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/tmdbExploreChipMovie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Movie"
                android:textAppearance="@style/SeasonChipLabel"
                app:chipStrokeColor="?attr/colorPrimaryContainer" />

            <com.google.android.material.chip.Chip
                android:id="@+id/tmdbExploreChipTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="TV show"
                android:textAppearance="@style/SeasonChipLabel"
                app:chipStrokeColor="?attr/colorPrimaryContainer" />

            <com.google.android.material.chip.Chip
                android:id="@+id/tmdbExploreChipAnimation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Animation"
                android:textAppearance="@style/SeasonChipLabel"
                app:chipStrokeColor="?attr/colorPrimaryContainer" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tmdbExploreStreamingRail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:clipToPadding="false"
        android:nextFocusUp="@+id/tmdbExploreTypeScroll"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbarSize="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <include
        android:id="@+id/rowInCinema"
        layout="@layout/item_explore_row" />

    <include
        android:id="@+id/rowTrending"
        layout="@layout/item_explore_row" />

    <include
        android:id="@+id/rowTopRated"
        layout="@layout/item_explore_row" />

    <include
        android:id="@+id/rowLatestRelease"
        layout="@layout/item_explore_row" />

    <include
        android:id="@+id/rowUpcoming"
        layout="@layout/item_explore_row" />

    <LinearLayout
        android:id="@+id/tmdbFranchiseHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="11dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:padding="8dp"
                android:text="@string/row_franchise"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/tmdbFranchiseSearch"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/franchise_search"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:padding="6dp"
                app:srcCompat="@drawable/ic_round_search_24"
                app:tint="?attr/colorOnSurface"
                tools:ignore="ImageContrastCheck" />

        </LinearLayout>

        <ani.sanin.ui.components.TomoeView
            android:id="@+id/tmdbFranchiseProgress"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone"
            tools:ignore="UnusedAttribute" app:lottie_rawRes="@raw/tomoe" app:lottie_autoPlay="true" app:lottie_loop="true" app:lottie_speed="1.75" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tmdbFranchiseSortPill"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:minWidth="0dp"
            android:text="@string/franchise_sort_random"
            android:textAllCaps="false"
            android:textColor="?attr/colorOnSurface"
            android:textSize="11sp"
            app:icon="@drawable/ic_expand_more"
            app:iconGravity="textEnd"
            app:iconPadding="4dp"
            app:iconSize="18dp"
            tools:ignore="SpUsage" />

        <ImageView
            android:id="@+id/tmdbFranchiseSortDirection"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/franchise_sort_direction"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:padding="3dp"
            app:srcCompat="@drawable/ic_round_unfold_more_24"
            app:tint="?attr/colorOnSurface"
            tools:ignore="ImageContrastCheck" />

    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tmdbFranchiseSearchBar"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:visibility="gone"
        app:boxBackgroundColor="@color/bg"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="28dp"
        app:boxCornerRadiusBottomStart="28dp"
        app:boxCornerRadiusTopEnd="28dp"
        app:boxCornerRadiusTopStart="28dp"
        app:endIconDrawable="@drawable/ic_round_search_24"
        app:hintAnimationEnabled="true">

        <AutoCompleteTextView
            android:id="@+id/tmdbFranchiseSearchText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:hint="@string/franchise_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:nextFocusUp="@id/tmdbFranchiseSearch"
            android:padding="8dp"
            android:selectAllOnFocus="true"
            android:textSize="14sp"
            tools:ignore="LabelFor,TextContrastCheck" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tmdbFranchiseMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:alpha="0.7"
        android:fontFamily="@font/poppins"
        android:gravity="center_horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="No franchise matches that"
        tools:visibility="visible" />

</LinearLayout>
