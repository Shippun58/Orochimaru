<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="28dp"
    android:paddingEnd="32dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/loggedOutTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:text="@string/logged_out_home_title"
        android:textColor="?attr/colorPrimary"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/loggedOutMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:alpha="0.72"
        android:gravity="center"
        android:text="@string/logged_out_home_message"
        android:textColor="?attr/colorOnSurface"
        android:textSize="15sp" />

    <Button
        android:id="@+id/loggedOutLinkButton"
        android:layout_width="128dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/logged_out_home_link"
        app:cornerRadius="16dp"
        tools:ignore="TextContrastCheck" />

</LinearLayout>
