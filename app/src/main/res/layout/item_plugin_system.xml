<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_settings_card"
    android:clickable="true"
    android:elevation="6dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:foreground="@drawable/fg_plugin_system_ripple"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/systemIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        tools:src="@drawable/ic_toggle_aniyomi" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/systemTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            tools:text="Aniyomi" />

        <TextView
            android:id="@+id/systemMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/poppins"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            tools:text="2 repos · 5 extensions" />
    </LinearLayout>

    <ImageView
        android:id="@+id/systemChevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:rotation="270"
        app:srcCompat="@drawable/ic_expand_more"
        app:tint="?attr/colorPrimary" />

</LinearLayout>
