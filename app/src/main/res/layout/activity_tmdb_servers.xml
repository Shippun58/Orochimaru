<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tmdbServersRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/tmdbServersScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/tmdbServersHeaderZone"
                android:layout_width="match_parent"
                android:layout_height="320dp">

                <ImageView
                    android:id="@+id/tmdbStreamsBackdrop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:importantForAccessibility="no"
                    tools:ignore="ContentDescription" />

                <View
                    android:id="@+id/tmdbStreamsScrim"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:id="@+id/tmdbServersTopBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <ImageButton
                        android:id="@+id/tmdbStreamsBack"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@color/nav_bg_inv"
                        android:focusable="true"
                        android:padding="10dp"
                        app:srcCompat="@drawable/ic_round_arrow_back_ios_new_24"
                        tools:ignore="ContentDescription" />

                    <ImageView
                        android:id="@+id/tmdbServersCompactLogo"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:adjustViewBounds="true"
                        android:alpha="0"
                        android:scaleType="fitStart"
                        android:importantForAccessibility="no"
                        tools:ignore="ContentDescription" />

                    <ImageButton
                        android:id="@+id/tmdbServersRefreshAll"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@color/nav_bg_inv"
                        android:focusable="true"
                        android:padding="10dp"
                        app:srcCompat="@drawable/ic_round_refresh_24"
                        tools:ignore="ContentDescription" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/tmdbStreamsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="6dp">

                <ImageView
                    android:id="@+id/tmdbStreamsLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="110dp"
                    android:layout_gravity="center_horizontal"
                    android:adjustViewBounds="true"
                    android:maxWidth="320dp"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tmdbStreamsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="24sp"
                    android:textColor="#FFFFFFFF"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:text="Title" />

                <TextView
                    android:id="@+id/tmdbStreamsEpisode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:fontFamily="@font/poppins"
                    android:textSize="13sp"
                    android:textColor="#F5C518"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Ssn2 Ep3: The Chi" />

                <TextView
                    android:id="@+id/tmdbStreamsRating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:fontFamily="@font/poppins"
                    android:textSize="14sp"
                    android:textColor="#FFFFFFFF"
                    android:maxLines="1"
                    tools:text="★ 7.9" />

                <TextView
                    android:id="@+id/tmdbStreamsMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:fontFamily="@font/poppins"
                    android:textSize="12sp"
                    android:textColor="#B3FFFFFF"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="13/11/2026  ·  1hr 2minutes" />

                <TextView
                    android:id="@+id/tmdbStreamsOverview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:fontFamily="@font/poppins"
                    android:textSize="12sp"
                    android:textColor="#80FFFFFF"
                    android:alpha="0.85"
                    android:maxLines="6"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tmdbServersStickyBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp">

                <View
                    android:id="@+id/tmdbServersDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:alpha="0.25"
                    android:background="#FFFFFFFF" />

                <HorizontalScrollView
                    android:id="@+id/tmdbStreamsChipScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="10dp"
                    android:clipToPadding="false">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/tmdbStreamsChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:chipSpacingHorizontal="10dp" />
                </HorizontalScrollView>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tmdbStreamsRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="4dp"
                android:paddingBottom="64dp"
                android:focusable="false"
                tools:listitem="@layout/item_url" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
