<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <ImageView
        android:id="@+id/tmdbStreamsBackdrop"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        tools:ignore="ContentDescription" />

    <View
        android:id="@+id/tmdbStreamsScrim"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="@drawable/tmdb_detail_gradient"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/tmdbStreamsHeaderScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/tmdbStreamsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:paddingStart="16dp"
                android:paddingEnd="24dp">

                <ImageButton
                    android:id="@+id/tmdbStreamsBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@color/nav_bg_inv"
                    android:focusable="true"
                    android:padding="10dp"
                    app:srcCompat="@drawable/ic_round_arrow_back_ios_new_24"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:id="@+id/tmdbStreamsLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="120dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp"
                    android:adjustViewBounds="true"
                    android:maxWidth="320dp"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tmdbStreamsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="24sp"
                    android:textColor="#FFFFFFFF"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:text="Title" />

                <TextView
                    android:id="@+id/tmdbStreamsMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:fontFamily="@font/poppins"
                    android:textSize="14sp"
                    android:textColor="#B3FFFFFF"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:text="2021 · Action, Thriller · ★ 7.8" />

                <TextView
                    android:id="@+id/tmdbStreamsEpisode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:fontFamily="@font/poppins"
                    android:textSize="13sp"
                    android:textColor="#F5C518"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="S1 · E2 — Pilot" />

                <HorizontalScrollView
                    android:id="@+id/tmdbStreamsChipScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/tmdbStreamsChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:chipSpacingHorizontal="10dp" />
                </HorizontalScrollView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_marginTop="10dp"
                    android:alpha="0.25"
                    android:background="#FFFFFFFF" />
            </LinearLayout>
        </ScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tmdbStreamsRows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="64dp"
            android:focusable="false"
            tools:listitem="@layout/item_url" />
    </LinearLayout>
</FrameLayout>
