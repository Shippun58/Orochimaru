<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    app:cardBackgroundColor="@color/servers_row_background"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <androidx.cardview.widget.CardView
            android:layout_width="44dp"
            android:layout_height="66dp"
            app:cardBackgroundColor="@color/nav_bg"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/tmdbExtraPoster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no"
                tools:ignore="ContentDescription" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tmdbExtraTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/tmdb_neutral_text"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Title" />

            <TextView
                android:id="@+id/tmdbExtraMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="★ 7.9  •  2026  •  Popularity 12.3" />

            <TextView
                android:id="@+id/tmdbExtraOverview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:alpha="0.85"
                android:textSize="11sp"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Overview text" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
